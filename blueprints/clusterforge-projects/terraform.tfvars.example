# Billing account ID for all projects
# Get this from: gcloud billing accounts list
billing_account = "01AB23-CD45EF-G6HI90"

# Optional: Folder ID to create projects under
# Get this from: gcloud resource-manager folders list
# Uncomment and set if you want projects under a specific folder
# folder_id = "123456789012"

# Optional: Override project IDs (defaults are shown)
# shared_project_id = "clusterforge-shared"
# dev_project_id    = "clusterforge-dev"
# prod_project_id   = "clusterforge-prod"
# sandbox_project_id = "clusterforge-sandbox"

# Optional: Override project names
# shared_project_name = "ClusterForge Shared Services"
# dev_project_name    = "ClusterForge Development"
# prod_project_name   = "ClusterForge Production"
# sandbox_project_name = "ClusterForge Sandbox"

# Optional: Additional labels for all projects
# additional_labels = {
#   team       = "platform"
#   cost-center = "engineering"
#   compliance = "pci-dss"
# }

# Optional: Create platform service accounts in all projects
# create_platform_service_accounts = true
